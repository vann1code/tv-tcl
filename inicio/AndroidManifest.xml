<?xml version="1.0" encoding="utf-8"?>
<!-- Tela inicial da TV TCL e serviço que remapeia os botões do controle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.casa.inicio"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Prévia ao vivo das entradas (TvView) -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Concedida via adb; usada só para religar o próprio serviço de acessibilidade (ver Ativador). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application android:label="Início" android:allowBackup="false">
        <!-- Escala do vídeo da prévia (TTvPictureManager); opcional para o app abrir em outra TV -->
        <uses-library android:name="com.tcl.tvmanager" android:required="false" />
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".Botoes"
            android:label="@string/botoes_nome"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/botoes" />
        </service>

        <receiver android:name=".Ativador" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
